<a class="game-card" href="/games/{{gameId}}">
    <div class="cover" style="{{coverStyle}}">
        <span class="cover-initials">{{initials}}</span>
        <span class="score-badge {{scoreClass}}">{{avgRatingDisplay}}</span>
    </div>
    <div class="game-card-body">
        <h3 class="game-card-title">{{title}}</h3>
        <p class="muted small">{{genre}} &middot; {{releaseYear}}</p>
        <p class="stars small">{{stars}} <span class="muted">({{reviewCount}})</span></p>
    </div>
</a>
